{
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/node_modules/**",
    "**/.next/**",
    "**/.content-collections/**",
    "**/repos/**"
  ],
  "format_on_save": "on",
  "formatter": [
    {
      "language_server": {
        "name": "oxfmt"
      }
    }
  ],
  "code_actions_on_format": {
    "source.fixAll.oxc": true
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "lint": {
          "cssConflict": "ignore"
        }
      }
    },
    "tailwindcss-intellisense-css": {
      "settings": {
        "css": {
          "lint": {
            "validProperties": ["corner-shape"]
          }
        }
      }
    },
    "vscode-css-language-server": {
      "settings": {
        "css": {
          "lint": {
            "unknownAtRules": "ignore"
          }
        }
      }
    }
  },
  "languages": {
    "CSS": {
      "language_servers": [
        "tailwindcss-intellisense-css",
        "!vscode-css-language-server",
        "..."
      ]
    },
    "JavaScript": {
      "language_servers": [
        "vtsls",
        "effect-tsgo",
        "oxlint",
        "oxfmt",
        "tailwindcss-language-server"
      ],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "JSX": {
      "language_servers": [
        "vtsls",
        "effect-tsgo",
        "oxlint",
        "oxfmt",
        "tailwindcss-language-server"
      ],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "TSX": {
      "language_servers": [
        "vtsls",
        "effect-tsgo",
        "oxlint",
        "oxfmt",
        "tailwindcss-language-server"
      ],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "TypeScript": {
      "language_servers": [
        "vtsls",
        "effect-tsgo",
        "oxlint",
        "oxfmt",
        "tailwindcss-language-server"
      ],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    }
  }
}
