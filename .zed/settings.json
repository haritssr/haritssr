{
  "code_actions_on_format": {
    "source.action.useSortedAttributes.biome": true,
    "source.fixAll.biome": true,
    "source.action.useSortedKeys.biome": false,
    "source.action.useSortedInterfaceMembers.biome": false,
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/node_modules/**",
    "**/.next/**",
    "**/.content-collections/**",
    "**/repos/**"
  ],
  "format_on_save": "on",
  "formatter": "language_server",
  "lsp": {
    "vscode-css-language-server": {
      "settings": {
        "css": {
          "lint": {
            "unknownAtRules": "ignore"
          }
        }
      }
    }
  },
  "languages": {
    "CSS": {
      "language_servers": [
        "tailwindcss-language-server",
        "vscode-css-language-server"
      ]
    },
    "JavaScript": {
      "language_servers": [
        "vtsls",
        "effect-tsgo",
        "biome"
      ],
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      }
    },
    "JSX": {
      "language_servers": [
        "vtsls",
        "effect-tsgo",
        "biome"
      ],
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      }
    },
    "TSX": {
      "language_servers": [
        "vtsls",
        "effect-tsgo",
        "biome"
      ],
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      }
    },
    "TypeScript": {
      "language_servers": [
        "vtsls",
        "effect-tsgo",
        "biome"
      ],
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      }
    }
  }
}
