{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedAttributes": "on"
      }
    }
  },
  "linter": {
    "rules": {
      "style": {
        "useFilenamingConvention": "off"
      }
    }
  },
  "formatter": {
    "enabled": true
  },
  "files": {
    "includes": [
      "!**/.next/**/*",
      "!**/node_modules/**/*",
      "!**/.swc/**/*",
      "!**/.contentlayer/**/*",
      "!**/.content-collections/**/*",
      "!**/.vscode/**/*"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ]
}
