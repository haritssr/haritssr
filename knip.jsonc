{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Turbopack discovers these MDX entry modules through import.meta.glob.
  "entry": [
    "public/sw.js",
    "scripts/{inspect-*-db.js,validate-content.ts}!",
    "data/blog/*.mdx",
  ],
  "ignoreDependencies": [
    // The trailing ! scopes this to production mode. next.config.ts loads the
    // package during configuration, which Knip excludes from that graph.
    "@next/mdx!",
  ],
}
