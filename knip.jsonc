{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Include discovered MDX modules and standalone operational scripts.
  "entry": [
    "public/sw.js",
    "app/[(]tools[)]/tree/{dev,generate-project-inventory}.ts!",
    // Bun discovers this in normal mode; production mode still needs it explicitly.
    "utils/content/validate-content.ts!",
    // Bun discovers this script in development; production mode needs it explicitly.
    "app/[(]tools[)]/commits/import-commits.ts!",
    "app/[(]tools[)]/timer/{migrate-timer,seed-timer}.ts!",
    "app/writing/content/*.mdx",
    // Timer tests run with `bun test`; they are entry points in normal mode only.
    "app/[(]tools[)]/timer/**/*.test.ts",
  ],
  // Tests and their fixtures are not production code.
  "ignore": [
    "app/[(]tools[)]/timer/**/*.test.ts",
    "app/[(]tools[)]/timer/utils/timerTestFixtures.ts",
  ],
  "ignoreDependencies": [
    // The trailing ! scopes this to production mode. next.config.ts loads the
    // package during configuration, which Knip excludes from that graph.
    "@next/mdx!",
  ],
}
