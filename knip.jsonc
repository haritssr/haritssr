{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [
    "app/experiments/ui-explorations/tools/db.bun.ts",
    "public/sw.js",
    "utils/{dbExperiment,sqlite3}.js",
  ],
  "ignoreFiles": [
    // These components are retained for features that are currently unwired.
    "components/InternalLinkWithoutArrow.tsx",
    "components/TopBarSearch.tsx",
    "data/routes.ts",
    "utils/someContext.tsx",
  ],
  "ignore": [
    // Keep the mutation methods available for the next tools-page iteration.
    "app/experiments/ui-explorations/tools/db.core.ts",
  ],
}
