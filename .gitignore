# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# testing
/coverage

# next.js
/.next/

# misc
.DS_Store
*.pem
# Commit history is imported directly from Git; do not restore JSON snapshots.
/app/(tools)/commits/changelog.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env.*

# Personal timer history (generated mock days also stay local)
/data/timer/*.json
/data/timer/*.tmp

*.tsbuildinfo

.zed/

next-env.d.ts

# Keep loose MP3s private; included songs belong in public/music.
/*.mp3
